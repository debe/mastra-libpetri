{
  "name": "mastra-libpetri",
  "version": "0.1.0",
  "private": true,
  "description": "An alternative execution engine for Mastra workflows, built on libpetri",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mastra-libpetri": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mastra": {
      "import": "./dist/mastra/index.js",
      "types": "./dist/mastra/index.d.ts"
    },
    "./compiler": {
      "import": "./dist/compiler/index.js",
      "types": "./dist/compiler/index.d.ts"
    },
    "./verify": {
      "import": "./dist/verify/index.js",
      "types": "./dist/verify/index.d.ts"
    },
    "./codec": {
      "import": "./dist/codec/index.js",
      "types": "./dist/codec/index.d.ts"
    },
    "./conformance": {
      "import": "./dist/conformance/index.js",
      "types": "./dist/conformance/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "libpetri": "^8.0.0"
  },
  "devDependencies": {
    "@mastra/core": "^1.67.0",
    "@types/node": "^26.4.1",
    "tsup": "^8.5.1",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.67.0 <2"
  }
}
